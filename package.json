{
  "name": "obsidian-kanban-todo-board",
  "version": "1.2.0",
  "description": "Kanban boards stored as files in your vault, with an Eisenhower matrix, a completion log and a skill radar chart.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "seed": "node scripts/seed-board.mjs"
  },
  "keywords": [
    "obsidian",
    "kanban",
    "todo"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
